@'
# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
.turbo/
.cache/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Environment / secrets
.env
.env.*
!.env.example
env*.local
*.pem
*.key
*.p12
*.pfx

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Logs / local runtime
*.log
logs/
tmp/
temp/

# Local databases / exports / backups
*.db
*.sqlite
*.sqlite3
*.dump
exports/
imports/local/
uploads/
backend/var/
frontend/public/uploads/
backups/
'@ | Set-Content -Path .gitignore -Encoding utf8